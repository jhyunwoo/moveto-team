{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moveto-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-16",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moveto-api",
      "database_id": "7b65613e-e6e4-4cd5-8a98-2e8a1a224e66"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "db96a3c2aa964c7392aa86d3dcbbf5d0"
    }
  ],
  "routes": [
    {
      "pattern": "api.moveto.kr",
      "custom_domain": true
    }
  ]
