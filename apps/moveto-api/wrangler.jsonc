{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moveto-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-02",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moveto-api",
      "database_id": "3f52cf74-a039-49bd-a998-68fd00883433"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f47d228a5c8d488883b8317ad81fd0d8"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "moveto-v3",
      "binding": "R2"
    }
  ],
  "services": [
    {
      "binding": "ARGON2",
      "service": "argon2"
    }
  ]
  // "compatibility_flags": [
