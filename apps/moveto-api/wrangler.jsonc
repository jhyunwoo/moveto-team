{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moveto-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-02",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hono-cf-template",
      "database_id": "844261f7-40e4-48ce-a36d-2e0f7758468d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "hono_cf_template",
      "id": "9208a67ecaa74515afe7f2bd853b4147"
    }
  ],
  "services": [
    {
      "binding": "ARGON2",
      "service": "argon2"
    }
  ]
