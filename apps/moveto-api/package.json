{
  "name": "moveto-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "./local-generate.sh",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push:local": "drizzle-kit generate && ./local-generate.sh",
    "db:push:prod": "drizzle-kit generate && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/binary": "^1.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.7.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.3",
    "hono": "^4.8.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "drizzle-kit": "^0.31.4",
    "wrangler": "^4.25.0"
  }
}
