{
  "name": "moveto-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "./local-generate.sh",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push:local": "drizzle-kit generate && ./local-generate.sh",
    "db:push:prod": "drizzle-kit generate && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@repo/transactional": "workspace:*",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.5",
    "resend": "^4.8.0",
    "validator": "^13.15.15",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/validator": "^13.15.2",
    "drizzle-kit": "^0.31.4",
    "wrangler": "^4.33.1"
  }
}
