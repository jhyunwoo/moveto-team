{
  "name": "hono-cf-template",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "./local-generate.sh",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push:local": "drizzle-kit generate && ./local-generate.sh",
    "db:push:prod": "drizzle-kit generate && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier -w ."
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.3",
    "hono": "^4.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "drizzle-kit": "^0.31.4",
    "wrangler": "^4.26.0"
  }
}
